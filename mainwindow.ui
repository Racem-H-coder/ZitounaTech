                  <item>
                   <widget class="QTableWidget" name="employeeTable_5">
                    <property name="minimumSize">
                     <size>
                      <width>900</width>
                      <height>320</height>
                     </size>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">/* =========================
   QTableWidget ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Green Accent Theme
   ========================= */

QTableWidget {
    border: 1px solid #dee2e6;
    border-radius: 12px;
    background-color: #ffffff;
    gridline-color: transparent;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #1f2937; /* DARK TEXT */
    selection-background-color: transparent;
    outline: none;
}

/* Focus */
QTableWidget:focus {
    border: 2px solid #2E7D32;
}

/* =========================
   Table Items
   ========================= */

QTableWidget::item {
    padding: 18px 12px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    background-color: transparent;
    color: #1f2937;
    min-height: 40px;
    max-height: 40px;
}

/* Hover */
QTableWidget::item:hover {
    background-color: rgba(46, 125, 50, 0.08);
    border-radius: 6px;
}

/* Selected */
QTableWidget::item:selected {
    background-color: #E8F5E9;       /* Light green */
    color: #1f2937;                  /* KEEP TEXT DARK */
    border: 2px solid #2E7D32;       /* Green accent */
    border-radius: 8px;
}

/* Selected Hover */
QTableWidget::item:selected:hover {
    background-color: rgba(46, 125, 50, 0.15);
}

/* Keyboard Focus */
QTableWidget::item:focus {
    outline: 2px solid #2E7D32;
    outline-offset: 2px;
}

/* =========================
   Header
   ========================= */

QHeaderView::section {
    background-color: #ffffff;
    padding: 16px 12px;
    border: none;
    border-bottom: 3px solid #2E7D32;
    font-weight: 700;
    font-size: 14px;
    color: #1f2937;
    letter-spacing: 0.5px;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    min-height: 45px;
}

QHeaderView::section:hover {
    background-color: rgba(46, 125, 50, 0.05);
}

/* =========================
   Column 0 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Selection / Icon
   ========================= */

QTableWidget::item[column=&quot;0&quot;] {
    text-align: center;
    background-color: #F1F8F4;
    border-radius: 8px;
    border: 2px solid rgba(46, 125, 50, 0.25);
    margin: 6px;
    min-width: 40px;
    min-height: 40px;
    font-size: 18px;
    color: #1f2937;
}

QTableWidget::item[column=&quot;0&quot;]:hover {
    background-color: #E8F5E9;
    border: 2px solid #2E7D32;
}

/* =========================
   Column 1 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Avatar
   ========================= */

QTableWidget::item[column=&quot;1&quot;] {
    padding: 8px;
    text-align: center;
    background-color: #F1F8F4;
    border-radius: 50px;
    border: 3px solid rgba(46, 125, 50, 0.25);
    margin: 6px;
    min-width: 80px;
    min-height: 80px;
    max-width: 80px;
    max-height: 80px;
}

QTableWidget::item[column=&quot;1&quot;]:hover {
    border: 3px solid #2E7D32;
}

/* =========================
   Column 3 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Name
   ========================= */

QTableWidget::item[column=&quot;3&quot;] {
    font-weight: 600;
    font-size: 16px;
    color: #1f2937;
    padding-left: 20px;
    letter-spacing: 0.3px;
}

QTableWidget::item[column=&quot;3&quot;]:hover {
    background-color: rgba(46, 125, 50, 0.08);
    border-radius: 6px;
}

/* =========================
   Column 4 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Email
   ========================= */

QTableWidget::item[column=&quot;4&quot;] {
    color: #374151;
    font-size: 14px;
}

/* =========================
   Column 5 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Role Badge
   ========================= */

QTableWidget::item[column=&quot;5&quot;] {
    background-color: #E8F5E9;
    border-radius: 12px;
    margin: 4px 2px;
    text-align: center;
    color: #1f2937;
    font-weight: 500;
}

/* =========================
   Column 6 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ Phone
   ========================= */

QTableWidget::item[column=&quot;6&quot;] {
    color: #374151;
}

/* =========================
   Scroll Bars
   ========================= */

QScrollBar:vertical {
    background: #f8f9fa;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #2E7D32;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #1B5E20;
}

QScrollBar:horizontal {
    background: #f8f9fa;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #2E7D32;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #1B5E20;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    border: none;
    background: transparent;
}
</string>
                    </property>
                    <property name="verticalScrollBarPolicy">
                     <enum>Qt::ScrollBarPolicy::ScrollBarAsNeeded</enum>
                    </property>
                    <property name="horizontalScrollBarPolicy">
                     <enum>Qt::ScrollBarPolicy::ScrollBarAsNeeded</enum>
                    </property>
                    <property name="autoScroll">
                     <bool>true</bool>
                    </property>
                    <property name="editTriggers">
                     <set>QAbstractItemView::EditTrigger::NoEditTriggers</set>
                    </property>
                    <property name="tabKeyNavigation">
                     <bool>true</bool>
                    </property>
                    <property name="dragDropOverwriteMode">
                     <bool>false</bool>
                    </property>
                    <property name="alternatingRowColors">
                     <bool>false</bool>
                    </property>
                    <property name="selectionMode">
                     <enum>QAbstractItemView::SelectionMode::SingleSelection</enum>
                    </property>
                    <property name="selectionBehavior">
                     <enum>QAbstractItemView::SelectionBehavior::SelectRows</enum>
                    </property>
                    <property name="showGrid">
                     <bool>false</bool>
                    </property>
                    <property name="wordWrap">
                     <bool>false</bool>
                    </property>
                    <property name="cornerButtonEnabled">
                     <bool>false</bool>
                    </property>
                    <property name="rowCount">
                     <number>1</number>
