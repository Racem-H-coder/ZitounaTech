                 <string notr="true">/* Enhanced Profile Tab Widget - Modern Flat Design */
QTabWidget::pane {
    border: 1px solid #e1e8ed;
    border-radius: 12px;
    background-color: #ffffff;
    margin-top: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 8px;
}

QTabBar::tab {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 12px 20px;
    margin-right: 2px;
    font-weight: 700;
    color: #495057;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
    min-width: 100px;
    letter-spacing: 0.3px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #556B2F;
    border-bottom: 3px solid #556B2F;
    font-weight: 700;
}


QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
    color: #495057;
    border-bottom: 3px solid #adb5bd;
}
</string>
