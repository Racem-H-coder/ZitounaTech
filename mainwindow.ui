    <property name="styleSheet">
     <string notr="true">QWidget#sidebarWidget {
    background-color: #F1F8F4;      /* Light green background */
    border-right: 1px solid #C8E6C9; /* Soft green border */
}

QWidget#sidebarWidget QPushButton {
    text-align: left;
    padding: 16px 24px;
    border: none;
    background-color: transparent;
    color: #1f2937;                 /* Dark text for readability */
    font-weight: 400;
    font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.5px;
    border-radius: 0;
    margin: 0;
    border-left: 3px solid transparent;
}

/* Hover */
QWidget#sidebarWidget QPushButton:hover {
    background-color: #E8F5E9;
    color: #2E7D32;
    border-left: 3px solid #2E7D32;
}

/* Pressed */
QWidget#sidebarWidget QPushButton:pressed {
    background-color: #C8E6C9;
    color: #1B5E20;
    border-left: 3px solid #1B5E20;
}

/* Checked / Active */
QWidget#sidebarWidget QPushButton[checked=&quot;true&quot;] {
    background-color: #E8F5E9;
    color: #2E7D32;
    border-left: 3px solid #2E7D32;
    font-weight: 500;
}
</string>
